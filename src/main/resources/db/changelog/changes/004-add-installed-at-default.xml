<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-add-installed-at-default" author="app">
        <!-- Update existing records to set installed_at to created_at if it's null -->
        <sql>
            UPDATE shopify_tokens SET installed_at = created_at WHERE installed_at IS NULL;
        </sql>
        
        <!-- Make sure the installed_at column has a NOT NULL constraint -->
        <addNotNullConstraint tableName="shopify_tokens" 
                              columnName="installed_at" 
                              columnDataType="timestamp with time zone"
                              defaultNullValue="now()"/>
    </changeSet>
</databaseChangeLog>
